{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fersandovalgtz/libro-texto-mexicano-digital/blob/main/schemas/ltmd_page_ocr.schema.json",
  "title": "LTMD page-level OCR record",
  "description": "Local reconstructible page-level OCR record for the LTMD Full-Text Research Layer. Complete OCR text is not intended for public redistribution by default.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pipeline_version",
    "page_id",
    "viewer_key",
    "canonical_viewer_key",
    "wave",
    "catalog_generation",
    "grade_code",
    "title_core",
    "page_index",
    "viewer_page",
    "source_asset_url",
    "source_sha256",
    "source_byte_size",
    "ocr_engine",
    "ocr_engine_version",
    "ocr_language",
    "ocr_psm",
    "ocr_text_raw",
    "ocr_sha256",
    "search_text",
    "search_text_sha256",
    "ocr_confidence_mean",
    "ocr_char_count",
    "ocr_word_count",
    "generated_at"
  ],
  "properties": {
    "schema_version": {"const": "LTMD_PAGE_OCR_0.1"},
    "pipeline_version": {"type": "string", "minLength": 1},
    "page_id": {"type": "string", "minLength": 1},
    "viewer_key": {"type": "string", "minLength": 1},
    "canonical_viewer_key": {"type": "string", "minLength": 1},
    "wave": {"type": "string", "pattern": "^W[0-9]+$"},
    "catalog_generation": {"type": "integer"},
    "grade_code": {"type": "integer"},
    "title_core": {"type": "string"},
    "page_index": {"type": "integer", "minimum": 0},
    "viewer_page": {"type": ["integer", "null"], "minimum": 0},
    "source_asset_url": {"type": "string", "format": "uri"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_byte_size": {"type": ["integer", "null"], "minimum": 0},
    "ocr_engine": {"type": "string", "minLength": 1},
    "ocr_engine_version": {"type": "string", "minLength": 1},
    "ocr_language": {"type": "string", "minLength": 1},
    "ocr_psm": {"type": "integer", "minimum": 0},
    "ocr_text_raw": {"type": "string"},
    "ocr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "search_text": {"type": "string"},
    "search_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ocr_confidence_mean": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
    "ocr_char_count": {"type": "integer", "minimum": 0},
    "ocr_word_count": {"type": "integer", "minimum": 0},
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
