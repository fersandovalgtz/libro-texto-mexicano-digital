{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fersandovalgtz/libro-texto-mexicano-digital/schemas/ltmd_u2_page_count_resolution.schema.json",
  "title": "LTMD-U2 structural page-count resolution row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_object_id",
    "viewer_key",
    "asset_url",
    "observed_at",
    "page_count_state",
    "page_count",
    "remote_total_bytes",
    "network_bytes_fetched",
    "range_requests",
    "max_network_bytes",
    "startxref_offset",
    "xref_kind",
    "xref_sections_traversed",
    "root_ref",
    "pages_ref",
    "method",
    "source_admission_state",
    "text_verification_state",
    "evidence_scope",
    "error"
  ],
  "properties": {
    "source_object_id": {"type": "string", "pattern": "^CONALITEG:2026:primaria:[A-Z0-9]+$"},
    "viewer_key": {"type": "string", "pattern": "^[A-Z0-9]+$"},
    "asset_url": {"type": "string", "pattern": "^https://libros\\.conaliteg\\.gob\\.mx/pdf-reader/assets/primaria/2026/[A-Z0-9]+\\.pdf$"},
    "observed_at": {"type": "string", "const": "2026-09-02"},
    "page_count_state": {"type": "string", "const": "observed"},
    "page_count": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "remote_total_bytes": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "network_bytes_fetched": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "range_requests": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "max_network_bytes": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "startxref_offset": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "xref_kind": {"type": "string", "const": "classic"},
    "xref_sections_traversed": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "root_ref": {"type": "string", "pattern": "^[1-9][0-9]* [0-9]+ R$"},
    "pages_ref": {"type": "string", "pattern": "^[1-9][0-9]* [0-9]+ R$"},
    "method": {"type": "string", "const": "targeted_tail_startxref_classic_xref_catalog_pages_count"},
    "source_admission_state": {"type": "string", "const": "not_assessed"},
    "text_verification_state": {"type": "string", "const": "not_assessed"},
    "evidence_scope": {"type": "string", "const": "structural trailer/xref/catalog/root-/Pages-/Count only; no page enumeration, text extraction, OCR, or semantic validation"},
    "error": {"type": "string", "const": "none"}
  }
}
