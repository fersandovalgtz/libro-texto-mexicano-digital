{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fersandovalgtz/libro-texto-mexicano-digital/schemas/ltmd_u2_asset_resolution.schema.json",
  "title": "LTMD-U2 transport-level PDF asset resolution row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_object_id",
    "viewer_key",
    "asset_url",
    "observed_at",
    "http_status",
    "asset_resolution_state",
    "content_type",
    "accept_ranges",
    "total_bytes",
    "pdf_signature",
    "source_admission_state",
    "page_count_observation"
  ],
  "properties": {
    "source_object_id": {
      "type": "string",
      "pattern": "^CONALITEG:[0-9]{4}:primaria:[A-Z0-9]+$"
    },
    "viewer_key": {
      "type": "string",
      "pattern": "^[A-Z0-9]+$"
    },
    "asset_url": {
      "type": "string",
      "pattern": "^https://libros\\.conaliteg\\.gob\\.mx/pdf-reader/assets/primaria/[0-9]{4}/[A-Z0-9]+\\.pdf$"
    },
    "observed_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "http_status": {
      "type": "string",
      "pattern": "^[1-5][0-9]{2}$"
    },
    "asset_resolution_state": {
      "type": "string",
      "enum": ["resolved_pdf", "resolved_non_pdf", "not_found", "forbidden", "server_error", "http_other", "transport_error"]
    },
    "content_type": {
      "type": "string",
      "minLength": 1
    },
    "accept_ranges": {
      "type": "string",
      "minLength": 1
    },
    "total_bytes": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "pdf_signature": {
      "type": "string",
      "enum": ["true", "false"]
    },
    "source_admission_state": {
      "type": "string",
      "enum": ["not_assessed"]
    },
    "page_count_observation": {
      "type": "string",
      "enum": ["not_observed"]
    }
  }
}
